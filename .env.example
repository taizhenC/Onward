# Onward — environment template. Copy to .env.local and fill in. Never commit .env.local.
# The five PERSISTENCE=supabase vars travel together: URL + anon key + service-role key +
# IP salt + a separate TELEMETRY_ID_SECRET. Never reuse IP_HASH_SALT.

# ── Storage ──────────────────────────────────────────────────────────────────
# memory (default): in-process sessions + const figures; zero-config offline dev.
# supabase: durable sessions, DB-served figures, auth, rate limiting.
PERSISTENCE=memory
# CI/build-only escape hatch. Never set this in a deployed environment.
ONWARD_ALLOW_MEMORY_IN_PRODUCTION=false

NEXT_PUBLIC_SUPABASE_URL=
# Public by design — used by the browser for AUTH ENDPOINTS ONLY (anonymous sign-in,
# email linking, magic links). RLS is default-deny: this key can read no tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, server-only. Bypasses RLS — treat like an SSH key. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. Salts the per-IP rate-limit hash (raw IPs are never stored).
# Required when PERSISTENCE=supabase. Generate: openssl rand -hex 32
# Generate every configured secret with `openssl rand -hex 32`; weak or
# whitespace-only values fail closed.
IP_HASH_SALT=
# REQUIRED in Supabase and production modes. Dedicated HMAC secret for authenticated telemetry IDs;
# there is no IP_HASH_SALT fallback. Generate a different value: openssl rand -hex 32
TELEMETRY_ID_SECRET=
# During rotation, comma-separate prior telemetry secrets here for at least
# 30 days and until their associated flows/events/outbox retries are drained.
# Maximum 8.
TELEMETRY_ID_PREVIOUS_SECRETS=
# Temporary schema/config availability switch only. Keep true (or unset) after
# migrations 0011-0015 pass `npm run check-db`. Set false only to use legacy v2
# story creation, the prior progress CAS, legacy feedback, and legacy alternate
# claim RPCs during an incident; this loses linked telemetry and is not a
# substitute for 0011-0015 before activating transactional producers.
TELEMETRY_FLOW_BINDING_ENABLED=true
# Optional dedicated HMAC secret for ten-minute recovery-flow fingerprints.
# Production falls back to IP_HASH_SALT when this is blank.
MATCH_RECOVERY_TOKEN_SECRET=
# Optional dedicated HMAC secret for one-use post-story alternate capabilities.
# Falls back to MATCH_RECOVERY_TOKEN_SECRET, then IP_HASH_SALT.
ALTERNATE_STORY_TOKEN_SECRET=

# ── LLM (rerank + opening copy + closed hybrid plan) ─────────────────────────
# stub (default): keyword routing, no API calls. real: Cerebras.
LLM_PROVIDER=stub
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL_RERANK=gpt-oss-120b
LLM_MODEL_PROSE=gpt-oss-120b

# ── Embeddings (FacetsRAG retrieval) ─────────────────────────────────────────
# stub (default): keyword retrieval path. gemini: real semantic retrieval.
EMBEDDING_PROVIDER=stub
GEMINI_API_KEY=
# Optional overrides (defaults: gemini-embedding-001 @ 1536).
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=1536

# ── Retrieval mode ───────────────────────────────────────────────────────────
# keyword is the approved/default story-creation path.
# facetsrag and auto are eval/debug challengers; production and persisted story
# creation reject every non-keyword path until a new recipe clears promotion.
RETRIEVAL_MODE=keyword

# Emergency operational switch. Crisis resources remain available when false.
STORY_CREATION_ENABLED=true
# Production defaults to canonical unless this evaluated promotion flag is true.
HYBRID_STORY_COMPOSER_ENABLED=false
