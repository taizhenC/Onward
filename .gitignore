.claude/

# private local notes (listed in both casings so the rule also holds on
# case-sensitive filesystems; the Windows checkout is case-insensitive)
mvp.md
MVP.md
deploy.md
DEPLOY.md

# local database backups / recovery snapshots — a production dump must never
# be committed, whatever directory it lands in
.codex-recovery/
*.dump
*.sql.gz
*.b64
# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
.next/
.next-ci/
.next-*/
out/
next-env.d.ts

# production
build/

# environment — every dotenv variant Next.js loads natively (.env.development,
# .env.production, .env.staging, ...) except the committed template
.env*
!.env.example

# logs
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editorial workspace (Phase 1 readiness)
scripts/drafts/

# eval run dumps — detailed per-trial output stays local. Metrics-only evidence lives
# outside this directory under content-addressed evals/history and evals/shadow paths.
evals/runs/*

# story-quality research workspace
# Ignore rules prevent accidental commits; they are not an access-control boundary.
evals/story-quality/private/
evals/story-quality/runs/

# figure-story research workspace: candidate StorySpecs and their evidence
# stay local until a story is reviewed and seeded
docs/research/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# typescript
*.tsbuildinfo
